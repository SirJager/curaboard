{
	"camelCase": false,
	"customImports": {},
	"dateParser": "timestamp",
	"defaultSchemas": ["public"],
	"dialect": "postgres",
	"domains": true,
	"envFile": ".envrc",
	"excludePattern": null,
	"includePattern": "public.(directus_files|directus_folders|form_types|form_updates)",
	"logLevel": "warn",
	"numericParser": "string",
	"outFile": "./src/db/schema/types.ts",
	"overrides": {},
	"partitions": false,
	"print": false,
	"runtimeEnums": false,
	"singularize": false,
	"skipAutogeneratedFileComment": false,
	"typeMapping": {},
	"typeOnlyImports": true,
	"url": "env(DATABASE_URL)",
	"verify": false
}
